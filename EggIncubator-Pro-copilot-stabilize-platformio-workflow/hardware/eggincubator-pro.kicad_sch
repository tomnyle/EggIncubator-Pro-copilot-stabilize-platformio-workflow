  (label "ONEWIRE_DQ" (at 185 161.81 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2c8a3aab-35bd-42b2-b425-c391dd935cb5"))
  (text "GPIO labels with identical names are electrically connected by KiCad global-label net matching." (at 45 205 0) (effects (font (size 1.5 1.5))) (uuid "f73d8244-69b7-43a8-84b5-349b113ad3c7"))
  (text "J1 ESP32: pin breakout follows include/pins.h. GPIO23 drives both BTS7960 enable inputs. Relay controls are active LOW." (at 45 215 0) (effects (font (size 1.5 1.5))) (uuid "738aaf93-1a81-47ce-8254-eb223a51e8ab"))
  (text "J6 switches: connect each dry contact between its named signal and GND; firmware configures INPUT_PULLUP." (at 45 225 0) (effects (font (size 1.5 1.5))) (uuid "86b0fc73-5564-443d-a69d-305e3d629d2d"))
  (text "R1 is the recommended 4.7 kOhm DS18B20 pull-up between 3V3 and ONEWIRE_DQ. SHT31 SDA/SCL are separate." (at 45 235 0) (effects (font (size 1.5 1.5))) (uuid "7c0079b4-cb3d-4619-8ac1-6c21396160e7"))
  (text "Use 3.3 V-compatible relay/SSR inputs. Relay/driver logic supply voltage and load-side wiring depend on the exact module." (at 45 245 0) (effects (font (size 1.5 1.5))) (uuid "40d745b5-ab27-4dc6-8a65-e2f2dc1bb54f"))
  (text "Use a separate DC motor supply per BTS7960/motor ratings; connect logic grounds as specified by the module datasheet." (at 45 255 0) (effects (font (size 1.5 1.5))) (uuid "b12d6c7a-b808-4828-8c6d-c701e1d00ff3"))
  (text "Mains/heater/load wiring is intentionally omitted. Use correctly rated isolation, fusing and qualified mains installation." (at 45 265 0) (effects (font (size 1.5 1.5))) (uuid "ca0db027-2ffb-42ea-bf26-15c5fa96aaf4"))
